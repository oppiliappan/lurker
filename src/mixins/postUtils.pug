  function imgExt(p, id) {
    var data = getPostData(p);
    var metadata = data.media_metadata;
    if (metadata[id].status == 'valid') {
      return stripPrefix(metadata[id].m, "image/");
    } else {
      // dosent matter
      return 'jpg';
    }
  }
