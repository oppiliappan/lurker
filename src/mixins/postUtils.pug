  function postGalleryItems(p) {
    var data = getPostData(p);
    if (data.gallery_data && data.gallery_data.items) {
      return data.gallery_data.items.map((item, idx) => ({
        id: item.media_id,
        url: `https://i.redd.it/${item.media_id}.${imgExt(p, item.media_id)}`,
        total: data.gallery_data.items.length,
        idx: idx+1,
      }));
    } else {
      return null;
    }
  }
