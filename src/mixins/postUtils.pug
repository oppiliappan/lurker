  function decodePostVideoUrls(p) {
    var data = getPostData(p);
    // Video URLs have querystring separators that are HTML-encoded, so replace them.
    const expression = /&amp;/g;

    var hls_url = data.secure_media && data.secure_media.reddit_video && data.secure_media.reddit_video.hls_url ? data.secure_media.reddit_video.hls_url.replace(expression, '&') : '';
    var dash_url = data.secure_media && data.secure_media.reddit_video && data.secure_media.reddit_video.dash_url ? data.secure_media.reddit_video.dash_url.replace(expression, '&') : '';

    var fallback_url = data.secure_media && data.secure_media.reddit_video && data.secure_media.reddit_video.fallback_url ? data.secure_media.reddit_video.fallback_url.replace(expression, '&') : '';

    var scrubber_url = data.secure_media && data.secure_media.reddit_video && data.secure_media.reddit_video.scrubber_media_url ? data.secure_media.reddit_video.scrubber_media_url.replace(expression, '&') : '';
    var poster_url = data.preview && data.preview.images ? data.preview.images[0].source.url.replace(expression, '&') : '';

    return [hls_url, dash_url, fallback_url, scrubber_url, poster_url];
  }
